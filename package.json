{
  "name": "@huskly/cli",
  "version": "1.2.7",
  "description": "Terminal-based trading tools for Schwab and IBKR through the IBKR gateway",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "https://github.com/huskly/cli",
  "author": "Felipe Lima",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "imports": {
    "#src/*.js": {
      "tsx": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "huskly-cli": "./dist/cli/index.js",
    "huskly-cli-auth": "./dist/auth/cli.js",
    "huskly-cli-mcp": "./dist/mcp/bin.js"
  },
  "engines": {
    "node": ">=24.0.0 <26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:package": "node scripts/checkPackageFiles.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --conditions=tsx --import tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "check": "yarn lint && yarn format:check && yarn typecheck && yarn test",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/asciichart": "^1.5.8",
    "@types/node": "^26",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@huskly/ibkr-gateway-client": "0.17.0",
    "@huskly/schwab-client": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "asciichart": "^1.5.25",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^18.0.1",
    "ioredis": "^6.0.0",
    "keytar": "^7.9.0",
    "open": "^11.0.0",
    "ora": "^9.0.0",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  }
}
