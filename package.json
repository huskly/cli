{
  "name": "@huskly/cli",
  "version": "1.2.7",
  "description": "Terminal-based trading tools for Schwab and IBKR through the IBKR gateway",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": "https://github.com/huskly/cli",
  "author": "Felipe Lima",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "imports": {
    "#src/*.js": {
      "tsx": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "huskly-cli": "./dist/cli/index.js",
    "huskly-cli-auth": "./dist/auth/cli.js",
    "huskly-cli-mcp": "./dist/mcp/bin.js"
  },
  "engines": {
    "node": ">=24.0.0 <26.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:package": "node scripts/checkPackageFiles.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "node --conditions=tsx --import tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint src test --ext .ts",
    "lint:fix": "eslint src test --ext .ts --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "check": "yarn lint && yarn format:check && yarn typecheck && yarn test",
    "prepublishOnly": "yarn build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/asciichart": "^1.5.8",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@huskly/ibkr-gateway-client": "0.24.0",
    "@huskly/schwab-client": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "asciichart": "^1.5.25",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "keytar": "^7.9.0",
    "open": "^11.0.4",
    "ora": "^10.0.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  }
}
