# Optional runtime config
# LOG_LEVEL=info
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# IBKR (--broker ibkr) OAuth 1.0a credentials.
# Only needed when using `huskly-cli --broker ibkr ...`. Copy to `.env` and fill
# in the values from the IBKR self-service portal. The .pem key files and the DH
# prime are picked up automatically from the keys directory (cwd by default, or
# IBKR_KEYS_DIR) — they do NOT need to be set here.
# ---------------------------------------------------------------------------

# 9-character consumer key issued by IBKR
IBIND_OAUTH1A_CONSUMER_KEY=

# Access token + secret generated in the IBKR portal
IBIND_OAUTH1A_ACCESS_TOKEN=
IBIND_OAUTH1A_ACCESS_TOKEN_SECRET=

# Optional: OAuth realm. Defaults to "limited_poa" for the standard individual
# self-service flow; institutional consumers may need a different value.
# IBIND_OAUTH1A_REALM=limited_poa

# Optional: directory holding the .pem key files (private_signature.pem,
# private_encryption.pem, dhparam.pem). Defaults to the current working dir.
# IBKR_KEYS_DIR=

# Optional: override the account id to query (otherwise the first account is used)
# IBKR_ACCOUNT_ID=
