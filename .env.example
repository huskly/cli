# Optional runtime settings
# LOG_LEVEL=info
# REDIS_URL=redis://localhost:6379
# HUSKLY_MCP_DEFAULT_BROKER=schwab
# HUSKLY_EXT_OPERATOR=operator-id
# HUSKLY_ENABLE_LIVE_EXECUTION=true
# HUSKLY_PREVIEW_DIR=/absolute/path/to/private-preview-dir
# HUSKLY_EXECUTION_DIR=/absolute/path/to/private-execution-dir

# Optional path override for the CLI IBKR gateway credential file.
# The file must be a regular file, owned by the current user, and have mode 0600.
# HUSKLY_IBKR_GATEWAY_CLI_CONFIG=/absolute/path/to/ibkr-gateway-cli.json

# Optional path override for the MCP IBKR gateway credential file.
# The file must be a regular file, owned by the current user, and have mode 0600.
# HUSKLY_IBKR_GATEWAY_MCP_CONFIG=/absolute/path/to/ibkr-gateway-mcp.json
